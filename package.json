{
  "name": "manoj-portfolio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:backend": "pnpm --filter @manoj-portfolio/web-backend dev",
    "dev:fullstack": "pnpm --filter @manoj-portfolio/web-fullstack dev",
    "build:backend": "pnpm --filter @manoj-portfolio/web-backend build",
    "build:fullstack": "pnpm --filter @manoj-portfolio/web-fullstack build",
    "build": "pnpm run build:backend && pnpm run build:fullstack",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
